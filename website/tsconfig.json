{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    /* Preact Config */
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "skipLibCheck": true,
    "paths": {
      "react": ["./node_modules/preact/compat/"],
      "react-dom": ["./node_modules/preact/compat/"]
    }
  },
  // src only: vite.config.ts pulls in types that reach @types/node, which
  // then wins the DOM's setTimeout and hands back a NodeJS.Timeout.
  "include": ["node_modules/vite/client.d.ts", "src/**/*"]
}
